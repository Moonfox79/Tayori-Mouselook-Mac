@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: LGPL-2.1-only
+// Independently authored target-lock geometry, 2026.
+#ifndef TAYORI_AIM_H
+#define TAYORI_AIM_H
+#include <array>
+#include <cmath>
+namespace TayoriAim
+{
+using Vec = std::array<double, 3>;
+inline bool direction(const Vec& eye, const Vec& target, Vec& out)
+{
+    Vec d{};
+    for (int i = 0; i < 3; ++i)
+    {
+        if (!std::isfinite(eye[i]) || !std::isfinite(target[i])) return false;
+        d[i] = target[i] - eye[i];
+    }
+    const double length = std::hypot(d[0], d[1], d[2]);
+    if (!std::isfinite(length) || length < 0.05) return false;
+    for (int i = 0; i < 3; ++i) out[i] = d[i] / length;
+    return true;
+}
+}
+#endif
