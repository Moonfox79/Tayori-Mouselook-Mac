+// SPDX-License-Identifier: LGPL-2.1-only
+// Independently authored Tayori Mouselook prototype, 2026.
+#ifndef FS_FLOATER_TARGET_LOCK_H
+#define FS_FLOATER_TARGET_LOCK_H
+#include "llfloater.h"
+#include "lltimer.h"
+class LLScrollListCtrl;
+class LLVector3;
+
+class FSFloaterTargetLock final : public LLFloater
+{
+public:
+    explicit FSFloaterTargetLock(const LLSD& key);
+    bool postBuild() override;
+    void draw() override;
+    void onOpen(const LLSD& key) override;
+    void onClose(bool app_quitting) override;
+    static void openSelector();
+    static void stop();
+    // Called once per camera frame, after camera origin smoothing.
+    static bool applyFocus(const LLVector3& eye, LLVector3& focus, LLVector3& up);
+    static bool active();
+private:
+    void refresh();
+    void selectTarget();
+    LLScrollListCtrl* mList = nullptr;
+    LLTimer mRefreshTimer;
+    bool mRefreshing = false;
+};
+#endif
