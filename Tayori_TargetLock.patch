@@ -0,0 +1,175 @@
+// SPDX-License-Identifier: LGPL-2.1-only
+// Independently authored prototype; no code copied from private viewer forks.
+#include "llviewerprecompiledheaders.h"
+#include "fsfloatertargetlock.h"
+#include "tayoriaim.h"
+#include "llagent.h"
+#include "llagentcamera.h"
+#include "llavatarnamecache.h"
+#include "llbutton.h"
+#include "llfocusmgr.h"
+#include "llfloaterreg.h"
+#include "lljoint.h"
+#include "llscrolllistctrl.h"
+#include "lltextbox.h"
+#include "llviewerobjectlist.h"
+#include "llviewerregion.h"
+#include "llvoavatarself.h"
+#include "llworld.h"
+#include <algorithm>
+#include <string>
+#include <vector>
+
+namespace
+{
+LLUUID target_id;
+LLUUID source_region;
+bool was_mouselook = false;
+constexpr F32 RANGE = 96.f;
+LLVOAvatar* targetAvatar(const LLUUID& id)
+{
+    LLViewerObject* object = gObjectList.findObject(id);
+    if (!object || object->isDead() || !object->isAvatar()) return nullptr;
+    return object->asAvatar();
+}
+}
+
+FSFloaterTargetLock::FSFloaterTargetLock(const LLSD& key) : LLFloater(key) {}
+bool FSFloaterTargetLock::postBuild()
+{
+    mList = getChild<LLScrollListCtrl>("targets");
+    mList->setCommitOnSelectionChange(true);
+    mList->setCommitCallback([this](LLUICtrl*, const LLSD&) { selectTarget(); });
+    getChild<LLButton>("stop")->setClickedCallback([](LLUICtrl*, const LLSD&) { stop(); });
+    return true;
+}
+void FSFloaterTargetLock::onOpen(const LLSD& key)
+{
+    LLFloater::onOpen(key);
+    refresh();
+}
+void FSFloaterTargetLock::onClose(bool app_quitting)
+{
+    stop();
+    LLFloater::onClose(app_quitting);
+}
+void FSFloaterTargetLock::draw()
+{
+    if (mRefreshTimer.getElapsedTimeF32() >= 5.f) refresh();
+    LLFloater::draw();
+}
+void FSFloaterTargetLock::refresh()
+{
+    if (!mList) return;
+    mRefreshing = true;
+    const LLUUID selected = mList->getSelectedValue().asUUID();
+    mList->deleteAllItems();
+    uuid_vec_t ids;
+    std::vector<LLVector3d> positions;
+    LLWorld::getInstance()->getAvatars(&ids, &positions, gAgent.getPositionGlobal(), RANGE);
+    struct Entry { LLUUID id; F64 distance; std::string name; bool loaded; };
+    std::vector<Entry> entries;
+    const size_t count = std::min(ids.size(), positions.size());
+    for (size_t i = 0; i < count; ++i)
+    {
+        if (ids[i] == gAgent.getID()) continue;
+        LLAvatarName name;
+        const bool named = LLAvatarNameCache::get(ids[i], &name);
+        const F64 distance = (positions[i] - gAgent.getPositionGlobal()).length();
+        entries.push_back({ids[i], distance, named ? name.getDisplayName() : ids[i].asString(), targetAvatar(ids[i]) != nullptr});
+    }
+    std::sort(entries.begin(), entries.end(), [](const Entry& a, const Entry& b)
+    { return a.distance < b.distance || (a.distance == b.distance && a.id < b.id); });
+    for (const auto& e : entries)
+    {
+        LLSD row;
+        row["id"] = e.id;
+        row["columns"][0]["column"] = "name";
+        row["columns"][0]["value"] = e.name;
+        row["columns"][1]["column"] = "distance";
+        row["columns"][1]["value"] = llformat("%.1f m", e.distance);
+        row["columns"][2]["column"] = "loaded";
+        row["columns"][2]["value"] = e.loaded ? "Bereit" : "Nicht geladen";
+        mList->addElement(row);
+    }
+    if (selected.notNull()) mList->selectByID(selected);
+    mRefreshing = false;
+    mRefreshTimer.reset();
+}
+void FSFloaterTargetLock::selectTarget()
+{
+    if (mRefreshing) return;
+    const LLUUID id = mList->getSelectedValue().asUUID();
+    LLVOAvatar* av = targetAvatar(id);
+    if (id.isNull() || id == gAgent.getID() || !av || !gAgent.getRegion() ||
+        av->getRegion() != gAgent.getRegion())
+    {
+        getChild<LLTextBox>("status")->setText(std::string("Ziel muss geladen und in derselben Region sein."));
+        return;
+    }
+    stop();
+    target_id = id;
+    source_region = gAgent.getRegion()->getRegionID();
+    was_mouselook = false;
+    getChild<LLTextBox>("status")->setText(std::string("Ziel aktiv. F8: STOP | F9: anderes Ziel"));
+    setVisible(false);
+    gFocusMgr.setKeyboardFocus(nullptr);
+    gAgentCamera.changeCameraToMouselook(false);
+    if (!gAgentCamera.cameraMouselook())
+    {
+        stop();
+        setVisible(true);
+        getChild<LLTextBox>("status")->setText(std::string("Mouselook konnte nicht aktiviert werden."));
+    }
+}
+void FSFloaterTargetLock::openSelector()
+{
+    stop();
+    if (gAgentCamera.cameraMouselook()) gAgentCamera.changeCameraToThirdPerson();
+    LLFloaterReg::showInstance("fs_target_lock");
+}
+void FSFloaterTargetLock::stop()
+{
+    target_id.setNull();
+    source_region.setNull();
+    was_mouselook = false;
+}
+bool FSFloaterTargetLock::active() { return target_id.notNull(); }
+bool FSFloaterTargetLock::applyFocus(const LLVector3& eye, LLVector3& focus, LLVector3& up)
+{
+    if (!active()) return false;
+    if (!gFocusMgr.getAppHasFocus() || !gAgent.getRegion() ||
+        gAgent.getRegion()->getRegionID() != source_region ||
+        gAgent.getTeleportState() != LLAgent::TELEPORT_NONE || !isAgentAvatarValid())
+    { stop(); return false; }
+    if (!gAgentCamera.cameraMouselook())
+    {
+        if (was_mouselook) stop();
+        return false;
+    }
+    was_mouselook = true;
+    LLVOAvatar* av = targetAvatar(target_id);
+    if (!av || !av->getRegion() || av->getRegion() != gAgent.getRegion())
+    { stop(); return false; }
+    // Upper torso, in the same agent coordinates as the final rendered eye.
+    LLVector3 aim = av->getPositionAgent();
+    aim.mV[VZ] += 0.35f;
+    TayoriAim::Vec direction;
+    if (!TayoriAim::direction({eye.mV[0],eye.mV[1],eye.mV[2]},
+                             {aim.mV[0],aim.mV[1],aim.mV[2]}, direction))
+    { stop(); return false; }
+    LLVector3 at((F32)direction[0], (F32)direction[1], (F32)direction[2]);
+    focus = aim;
+    up = fabs(at.mV[VZ]) > .999f ? LLVector3::y_axis : LLVector3::z_axis;
+    // Keep the agent's own aim frame in agreement, including a seated parent's rotation.
+    if (gAgentAvatarp->getParent())
+    {
+        auto* parent = static_cast<LLViewerObject*>(gAgentAvatarp->getParent());
+        if (!parent->flagCameraDecoupled()) at = at * ~parent->getRenderRotation();
+    }
+    // resetAxes rejects a perfectly vertical look vector. The rendered focus remains exact.
+    if ((at % gAgent.getReferenceUpVector()).isNull())
+    { at.mV[VX] += .00001f; at.normalize(); }
+    gAgent.resetAxes(at);
+    return true;
+}
